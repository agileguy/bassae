{#- Base: openchat-3.5 chat template (GPT4 Correct turns). -#}
{{ '<s>' }}
{%- for message in messages -%}
  {%- if message['role'] == 'system' -%}
{{ message['content'] }}<|end_of_turn|>
  {%- elif message['role'] == 'user' -%}
GPT4 Correct User: {{ message['content'] }}<|end_of_turn|>
  {%- elif message['role'] == 'assistant' -%}
GPT4 Correct Assistant: {{ message['content'] }}<|end_of_turn|>
  {%- endif -%}
{%- endfor -%}
{#- Prefill / priming attack (arXiv:2602.14689; arXiv:2504.21038): instead of ending with a
    bare assistant turn marker, the generation prompt forces the assistant turn to begin
    with an attacker-chosen affirmative prefix, so the model continues from an already-
    complied opening rather than producing its own refusal. -#}
